# Environment variables for the original numbers.txt login (no Twilio/SMS OTP).
KITE_API_KEY=
KITE_ACCESS_TOKEN=
# Optional local cache directory; Render's original configuration has no persistent disk.
SCANNER_DATA_DIR=.runtime
SEED_DAYS_5M=45
SEED_DAYS_DAILY=120
ENABLE_FUTURES_OI=false
FAST_MODE=false

# Google + Razorpay Standard Checkout SANDBOX; disable live charging.
MEMBERSHIP_AUTH_MODE=google_test
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_PRIVATE_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_RAZORPAY=false

# TEST CHECKOUT (never charges real money):
# MEMBERSHIP_AUTH_MODE=google_test
# RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_OPTIONAL_TEST_WEBHOOK_SECRET
# ALLOW_LIVE_RAZORPAY=false
# Run SUPABASE_RAZORPAY_TEST_SETUP.sql before deploying.
